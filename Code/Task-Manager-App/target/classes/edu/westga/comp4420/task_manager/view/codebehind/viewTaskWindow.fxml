<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="guiPane" prefHeight="441.0" prefWidth="387.0" xmlns="http://javafx.com/javafx/22.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.comp4420.task_manager.view.codebehind.TaskDetailsWindow">
    <children>
        <Label layoutX="85.0" layoutY="75.0" text="Title:" />
        <TextField fx:id="titleTextField" editable="false" layoutX="142.0" layoutY="71.0" prefHeight="25.0" prefWidth="197.0" />

        <Label layoutX="72.0" layoutY="156.0" prefHeight="25.0" prefWidth="63.0" text="Description:" />
        <TextArea fx:id="descriptionTextArea" editable="false" layoutX="145.0" layoutY="119.0" prefHeight="99.0" prefWidth="197.0" wrapText="true" />

        <Label layoutX="87.0" layoutY="303.0" text="Due Date:" />
        <TextField fx:id="dueDateField" editable="false" layoutX="158.0" layoutY="299.0" prefHeight="25.0" prefWidth="190.0" />

        <Label layoutX="85.0" layoutY="248.0" text="Status:" />
        <TextField fx:id="statusField" editable="false" layoutX="146.0" layoutY="244.0" prefHeight="25.0" prefWidth="197.0" />

        <Button fx:id="closeButton" layoutX="171.0" layoutY="391.0" onAction="#handleCloseButtonAction" text="Close" />
    </children>
</AnchorPane>
