<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="MainWindow" minHeight="99.0" minWidth="160.0" prefHeight="478.0" prefWidth="511.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.comp4420.task_manager.view.codebehind.MainWindow">
   <children>
      <Label layoutX="190.0" layoutY="14.0" text="Task Manager">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>
      <TableView fx:id="taskTable" layoutX="12.0" layoutY="55.0" prefHeight="361.0" prefWidth="487.0">
        <columns>
          <TableColumn fx:id="statusColumn" prefWidth="75.0" text="Status" />
          <TableColumn fx:id="titleColumn" prefWidth="75.0" text="Title" />
            <TableColumn fx:id="descriptionColumn" prefWidth="257.0" text="Description" />
            <TableColumn fx:id="dueDateColumn" prefWidth="79.0" text="Due Date" />
        </columns>
      </TableView>
      <Button fx:id="addTaskButton" layoutX="430.0" layoutY="428.0" mnemonicParsing="false" onAction="#handleAddTaskButtonAction" text="Add Task" />
   </children>
</AnchorPane>
