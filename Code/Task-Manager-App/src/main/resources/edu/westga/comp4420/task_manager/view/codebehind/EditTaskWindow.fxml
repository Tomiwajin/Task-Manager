<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="guiPane" prefHeight="441.0" prefWidth="387.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.comp4420.task_manager.view.codebehind.EditTaskWindow">
   <children>
      <Label layoutX="139.0" layoutY="28.0" text="Edit Task">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>
      <Label layoutX="53.0" layoutY="114.0" prefHeight="23.0" prefWidth="77.0" text="Due Date:">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label layoutX="51.0" layoutY="198.0" prefHeight="23.0" prefWidth="59.0" text="Status:">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Button fx:id="updateButton" layoutX="285.0" layoutY="375.0" mnemonicParsing="false" onAction="#handleUpdateButtonAction" prefHeight="26.0" prefWidth="59.0" text="Update" />
      <Button fx:id="cancelButton" layoutX="53.0" layoutY="375.0" mnemonicParsing="false" onAction="#handleCancelButtonAction" text="Cancel" />
      <DatePicker fx:id="dueDatePicker" layoutX="175.0" layoutY="113.0" prefHeight="26.0" prefWidth="160.0" />
      <RadioButton fx:id="completeRadioButton" layoutX="162.0" layoutY="201.0" mnemonicParsing="false" text="Complete" />
      <RadioButton fx:id="incompleteRadioButton" layoutX="273.0" layoutY="201.0" mnemonicParsing="false" text="Incomplete" />
   </children>
</AnchorPane>
